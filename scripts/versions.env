# Pinned tool versions for the demonstration, the install script and CI.
# One file, so the demo, CI and every team member run the same tools.
# GO_VERSION must equal the `go` line in go.mod (CI checks this).
GO_VERSION=1.26.9
GRYPE_VERSION=v0.120.1
GOVULNCHECK_VERSION=v1.9.0
GOLANGCI_LINT_VERSION=v2.13.1

# The demonstration repository, pinned to a commit: a small Express app
# whose README documents CVE-2018-16487 (lodash _.merge) and whose index.js
# calls _.merge on request input. It is also audit case
# testdata/audit/kirill89-prototype-pollution-explained.
DEMO_REPO_URL=https://github.com/Kirill89/prototype-pollution-explained.git
DEMO_REPO_COMMIT=d7b5d98515a95f9a8cb0fedef034010ee083a6a9
